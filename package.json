{
  "name": "@sensehq/vue-plaid-link-next",
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source Vue integration for Plaid Link with composables, TypeScript support, and Plaid SDK lifecycle management.",
  "author": "Sense",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/vue-plaid-link-next.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/vue-plaid-link-next.umd.cjs"
      }
    }
  },
  "main": "./dist/vue-plaid-link-next.umd.cjs",
  "module": "./dist/vue-plaid-link-next.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist && vite build && vue-tsc --emitDeclarationOnly",
    "types:check": "vue-tsc --noEmit",
    "types:generate": "vue-tsc --emitDeclarationOnly",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.27.3",
    "@types/node": "^20.11.17",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.4",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "happy-dom": "^13.3.8",
    "rimraf": "^5.0.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^1.2.2",
    "vue-tsc": "^2.2.0"
}
}
